{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gpu-graphs.local/schema/topic-0.1.json",
  "title": "Direct-authored graph topic specification",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "coverage",
    "sources",
    "authoring",
    "qa"
  ],
  "properties": {
    "schema_version": { "const": "topic-0.1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "coverage": {
      "type": "object",
      "required": ["glob"],
      "properties": {
        "glob": { "type": "string", "pattern": "^graphs/[a-z0-9-]+/.+\\.svg$" }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "repository", "commit", "paths", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "kind": { "const": "implementation" },
          "repository": { "type": "string", "minLength": 1 },
          "commit": { "type": "string", "minLength": 7 },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "authoring": {
      "type": "object",
      "required": ["goal", "audience", "reading_order", "required_content", "excluded_content"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "reading_order": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_content": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "excluded_content": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "qa": {
      "type": "object",
      "required": ["profile", "min_width", "required_classes"],
      "properties": {
        "profile": { "const": "direct-role-memory" },
        "min_width": { "type": "integer", "minimum": 2400 },
        "required_classes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["class", "minimum"],
            "properties": {
              "class": { "type": "string", "minLength": 1 },
              "minimum": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "source_text_classes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
